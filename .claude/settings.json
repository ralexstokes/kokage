{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(./scripts/dev just *)",
      "Bash(./scripts/dev cargo check *)",
      "Bash(./scripts/dev cargo build *)",
      "Bash(./scripts/dev cargo test *)",
      "Bash(./scripts/dev cargo nextest *)",
      "Bash(./scripts/dev cargo +nightly clippy *)",
      "Bash(./scripts/dev cargo +nightly fmt *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "direnv allow \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(sed -n 's/.*\"worktree_path\" *: *\"\\([^\"]*\\)\".*/\\1/p'); direnv allow \"${d:-$CLAUDE_PROJECT_DIR}\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
